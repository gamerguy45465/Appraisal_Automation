{
  "html": "<html lang=\"en\"><head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <meta name=\"color-scheme\" content=\"light\">\n  <meta name=\"theme-color\" content=\"#163b43\">\n  <meta name=\"description\" content=\"Prepare an R3 AMC appraisal order from your loan documents, then review and submit it yourself.\">\n  <title>Appraisal Desk · Prepare an order</title>\n  <link rel=\"stylesheet\" href=\"/styles.css\">\n  <script src=\"/app.js\" defer=\"\"></script>\n</head>\n\n<body>\n  <a class=\"skip-link\" href=\"#order-form\">Skip to order form</a>\n  <header class=\"site-header\">\n    <div class=\"header-inner\">\n      <a class=\"brand\" href=\"/\" aria-label=\"Appraisal Desk home\">\n        <span class=\"brand-mark\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 32 32\" fill=\"none\">\n            <path d=\"M6 14 16 6l10 8v12H6V14Z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"></path>\n            <path d=\"M13 26v-9h6v9M11 12h10\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"></path>\n          </svg>\n        </span>\n        <span>Appraisal<span class=\"brand-light\">Desk</span></span>\n      </a>\n      <div class=\"workspace-label\"><span class=\"small-dot\" aria-hidden=\"true\"></span> Local workspace</div>\n    </div>\n  </header>\n\n  <main class=\"page-shell\">\n    <div class=\"page-intro\">\n      <div>\n        <p class=\"eyebrow\">LOAN PROCESSING / NEW APPRAISAL</p>\n        <h1>A prepared order.<br><span>Your final review.</span></h1>\n        <p class=\"intro-copy\">Bring your loan documents. We’ll prepare the details in R3 AMC, so you can review every\n          field before you submit.</p>\n      </div>\n      <div class=\"branch-tag\">\n        <svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" fill=\"none\">\n          <path d=\"M4 21h16M6 21V9l6-5 6 5v12M10 21v-6h4v6M9 10h6\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n        </svg>\n        <div><span>YOUR BRANCH</span><strong>GUILD 685 SUMMERLIN ONE</strong></div>\n      </div>\n    </div>\n\n    <div class=\"workspace-grid\">\n      <div class=\"form-column\">\n        <form id=\"order-form\" class=\"order-card\" action=\"/api/jobs\" method=\"post\" enctype=\"multipart/form-data\">\n          <div class=\"card-heading\">\n            <h2>Order details</h2><span><span class=\"required-mark\">*</span> Required</span>\n          </div>\n          <noscript>\n            <p class=\"noscript-message\">JavaScript is required to connect securely and follow your order’s progress.\n              Enable it, then reload this page.</p>\n          </noscript>\n          <div id=\"form-error\" class=\"form-error\" role=\"alert\" tabindex=\"-1\" hidden=\"\">\n            <strong id=\"error-title\">Please check your order</strong>\n            <p id=\"error-message\"></p>\n            <ul id=\"error-details\" hidden=\"\"></ul>\n          </div>\n\n          <fieldset id=\"order-fields\" class=\"form-fields\" disabled=\"\">\n            <legend class=\"sr-only\">Appraisal order information</legend>\n            <section class=\"form-section\" aria-labelledby=\"access-heading\">\n              <div class=\"section-heading\"><span class=\"section-number\" aria-hidden=\"true\">01</span>\n                <div>\n                  <h3 id=\"access-heading\">Connect your AI provider</h3>\n                  <p>Use your API key to prepare this order.</p>\n                </div>\n              </div>\n              <div class=\"field\">\n                <label for=\"provider\">AI provider <span class=\"required-mark\" aria-hidden=\"true\">*</span></label>\n                <select id=\"provider\" name=\"provider\" required=\"\">\n                  <option value=\"openai\">OpenAI</option>\n                  <option value=\"anthropic\">Anthropic</option>\n                  <option value=\"google\">Google</option>\n                  <option value=\"xai\">SpaceXAI</option>\n                </select>\n              </div>\n              <div class=\"field\">\n                <label for=\"model\">Model ID <span class=\"optional-label\">Optional</span></label>\n                <input id=\"model\" name=\"model\" type=\"text\" placeholder=\"gpt-5.6-sol\" autocomplete=\"off\" spellcheck=\"false\" maxlength=\"200\" aria-describedby=\"model-help\">\n                <p id=\"model-help\" class=\"field-help\">Leave blank to use gpt-5.6-sol. Choose a model available to your\n                  account with PDF, image, and tool support.</p>\n              </div>\n              <div class=\"field\">\n                <label for=\"apiKey\"><span id=\"api-key-label\">OpenAI API key</span> <span class=\"required-mark\" aria-hidden=\"true\">*</span></label>\n                <input id=\"apiKey\" name=\"apiKey\" type=\"password\" placeholder=\"Enter your OpenAI API key\" required=\"\" autocomplete=\"off\" spellcheck=\"false\" aria-describedby=\"api-key-help\">\n                <p class=\"field-help\" id=\"api-key-help\">Your PDFs and order details are sent to OpenAI. API usage is billed\n                  to your OpenAI account.</p>\n              </div>\n              <p class=\"field-help\">R3 AMC opens separately. Sign in and complete any CAPTCHA there; preparation\n                resumes automatically after you sign in.</p>\n            </section>\n\n            <section class=\"form-section\" aria-labelledby=\"loan-heading\">\n              <div class=\"section-heading\"><span class=\"section-number\" aria-hidden=\"true\">02</span>\n                <div>\n                  <h3 id=\"loan-heading\">Identify the loan</h3>\n                  <p>Match the order to the correct loan file.</p>\n                </div>\n              </div>\n              <div class=\"field-grid\">\n                <div class=\"field\"><label for=\"loanNumber\">Loan number <span class=\"required-mark\" aria-hidden=\"true\">*</span></label><input id=\"loanNumber\" name=\"loanNumber\" type=\"text\" placeholder=\"685-20xxxxx\" pattern=\"^685-20[0-9]{5}$\" title=\"Enter 685-20 followed by exactly five digits.\" maxlength=\"11\" required=\"\" autocomplete=\"off\" spellcheck=\"false\" aria-describedby=\"loan-help\">\n                  <p id=\"loan-help\" class=\"field-help\">685-20 followed by five digits.</p>\n                </div>\n                <div class=\"field\"><label for=\"fhaCaseNumber\">FHA case number <span class=\"optional-label\">Optional</span></label><input id=\"fhaCaseNumber\" name=\"fhaCaseNumber\" type=\"text\" placeholder=\"Enter if applicable\" maxlength=\"100\" autocomplete=\"off\" aria-describedby=\"fha-help\">\n                  <p id=\"fha-help\" class=\"field-help\">Required when your URLA identifies an FHA loan.</p>\n                </div>\n              </div>\n            </section>\n\n            <section class=\"form-section\" aria-labelledby=\"documents-heading\">\n              <div class=\"section-heading\"><span class=\"section-number\" aria-hidden=\"true\">03</span>\n                <div>\n                  <h3 id=\"documents-heading\">Add your documents</h3>\n                  <p>PDF files, up to 15 MiB each.</p>\n                </div>\n              </div>\n              <div class=\"document-grid\">\n                <div class=\"document-field\">\n                  <div class=\"document-top\"><span class=\"document-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\">\n                        <path d=\"M14 3H6v18h12V7l-4-4Z\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"></path>\n                        <path d=\"M14 3v5h4M9 12h6M9 16h6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path>\n                      </svg></span><span class=\"file-type\">PDF</span></div>\n                  <label for=\"urla\">URLA <span class=\"required-mark\" aria-hidden=\"true\">*</span></label>\n                  <p class=\"document-description\" id=\"urla-help\">Universal Residential Loan Application</p>\n                  <input id=\"urla\" name=\"urla\" type=\"file\" accept=\".pdf,application/pdf\" required=\"\" aria-describedby=\"urla-help urla-selection\">\n                  <p id=\"urla-selection\" class=\"file-selection\" aria-live=\"polite\">No document selected</p>\n                </div>\n                <div class=\"document-field\">\n                  <div class=\"document-top\"><span class=\"document-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\">\n                        <path d=\"M14 3H6v18h12V7l-4-4Z\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"></path>\n                        <path d=\"M14 3v5h4M9 12h6M9 16h4\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"></path>\n                      </svg></span><span class=\"file-type\">PDF</span></div>\n                  <label for=\"salesContract\">Sales contract <span class=\"optional-label\">Optional</span></label>\n                  <p class=\"document-description\" id=\"contract-help\">Include the contract for a purchase.</p>\n                  <input id=\"salesContract\" name=\"salesContract\" type=\"file\" accept=\".pdf,application/pdf\" aria-describedby=\"contract-help salesContract-selection\">\n                  <p id=\"salesContract-selection\" class=\"file-selection\" aria-live=\"polite\">No document selected</p>\n                </div>\n              </div>\n            </section>\n\n            <section class=\"form-section last-section\" aria-labelledby=\"preferences-heading\">\n              <div class=\"section-heading\"><span class=\"section-number\" aria-hidden=\"true\">04</span>\n                <div>\n                  <h3 id=\"preferences-heading\">Set order preferences</h3>\n                  <p>Choose how the appraisal will be handled.</p>\n                </div>\n              </div>\n              <div class=\"field\"><label for=\"paymentMethod\">Payment method <span class=\"required-mark\" aria-hidden=\"true\">*</span></label><select id=\"paymentMethod\" name=\"paymentMethod\" required=\"\">\n                  <option value=\"Invoice\">Invoice</option>\n                  <option value=\"Pay by Credit Card\">Pay by Credit Card</option>\n                  <option value=\"Request Payment From The Borrower\">Request Payment From The Borrower</option>\n                </select></div>\n              <label class=\"checkbox-field\" for=\"rushOrder\"><input id=\"rushOrder\" name=\"rushOrder\" type=\"checkbox\" value=\"true\"><span><strong>This is a rush order</strong><span>Flag the order for expedited handling\n                    in R3 AMC.</span></span></label>\n            </section>\n          </fieldset>\n\n          <div class=\"form-footer\">\n            <p><svg aria-hidden=\"true\" viewBox=\"0 0 20 20\" fill=\"none\">\n                <rect x=\"4.5\" y=\"8.5\" width=\"11\" height=\"8\" rx=\"2\" stroke=\"currentColor\" stroke-width=\"1.3\"></rect>\n                <path d=\"M7 8.5V6a3 3 0 0 1 6 0v2.5M10 12v1.5\" stroke=\"currentColor\" stroke-width=\"1.3\" stroke-linecap=\"round\"></path>\n              </svg>Your API key is cleared from this form after your order is accepted.</p>\n            <button id=\"submit-button\" class=\"primary-button\" type=\"submit\" disabled=\"\"><span id=\"submit-label\">Connecting\n                to workspace…</span><svg aria-hidden=\"true\" viewBox=\"0 0 20 20\" fill=\"none\">\n                <path d=\"M4 10h12m-5-5 5 5-5 5\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n              </svg></button>\n            <p class=\"submit-help\">This prepares an order. You make the final submission in R3 AMC.</p>\n          </div>\n        </form>\n      </div>\n\n      <aside class=\"sidebar\" aria-label=\"Order progress and guidance\">\n        <section id=\"status-card\" class=\"status-card\" aria-labelledby=\"status-heading\" data-status=\"ready\">\n          <div class=\"status-card-top\"><span class=\"eyebrow\">YOUR WORKFLOW</span><span id=\"status-badge\" class=\"status-badge\">Ready</span></div>\n          <div id=\"status-announcement\" role=\"status\" aria-live=\"polite\" aria-atomic=\"true\">\n            <h2 id=\"status-heading\">From documents<br>to a draft order.</h2>\n            <p id=\"status-message\">Add your details to begin. You’ll stay in control of the final submission.</p>\n          </div>\n          <ol class=\"workflow-list\">\n            <li id=\"step-extract\" data-state=\"waiting\"><span class=\"workflow-marker\" aria-hidden=\"true\">1</span>\n              <div><strong>Read your documents</strong>\n                <p>Extract the property and loan details.</p>\n              </div>\n            </li>\n            <li id=\"step-prepare\" data-state=\"waiting\"><span class=\"workflow-marker\" aria-hidden=\"true\">2</span>\n              <div><strong>Prepare in R3 AMC</strong>\n                <p>Sign in through the separate browser to continue.</p>\n              </div>\n            </li>\n            <li id=\"step-review\" data-state=\"waiting\"><span class=\"workflow-marker\" aria-hidden=\"true\">3</span>\n              <div><strong>You review &amp; submit</strong>\n                <p>Check every field, make changes, and submit.</p>\n              </div>\n            </li>\n          </ol>\n          <div id=\"login-notice\" class=\"review-notice\" hidden=\"\"><strong>Use the separate R3 AMC browser.</strong>\n            <p>Sign in and complete any CAPTCHA there. Preparation resumes automatically after you sign in.</p>\n          </div>\n          <div id=\"review-notice\" class=\"review-notice\" hidden=\"\"><strong>Continue in the R3 AMC browser.</strong>\n            <p>Review all information and warnings before submitting. The browser stays open until you close it.</p>\n          </div>\n          <div id=\"job-warnings\" class=\"job-warnings\" hidden=\"\"><strong>Review notes</strong>\n            <ul id=\"warnings-list\"></ul>\n          </div>\n          <p id=\"connection-message\" class=\"connection-message\" role=\"status\" hidden=\"\"></p>\n          <button id=\"reconnect-button\" class=\"secondary-button\" type=\"button\" hidden=\"\">Reconnect</button>\n        </section>\n\n        <section class=\"review-card\" aria-labelledby=\"review-heading\"><span class=\"review-icon\" aria-hidden=\"true\"><svg viewBox=\"0 0 24 24\" fill=\"none\">\n              <path d=\"m12 3 8 3v6c0 4-5 7-8 9-3-2-8-5-8-9V6l8-3Z\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"></path>\n              <path d=\"m8 12 3 3 5-6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path>\n            </svg></span>\n          <h3 id=\"review-heading\">The final say is yours.</h3>\n          <p>Appraisal Desk fills the form and hands it back to you. Only you can submit the order.</p>\n          <div class=\"review-card-note\">VA appraisals must be ordered through the VA portal. This workspace will stop if\n            a VA loan is identified.</div>\n        </section>\n        <p class=\"sidebar-footnote\">One order at a time. Keep this page open while your documents are being processed.\n        </p>\n      </aside>\n    </div>\n    <footer class=\"page-footer\"><span>Appraisal Desk</span><span>Prepared with care. Reviewed by you.</span></footer>\n  </main>\n\n\n\n</body></html>",
  "doctype": "html",
  "mode": "CSS1Compat",
  "title": "Appraisal Desk · Prepare an order"
}