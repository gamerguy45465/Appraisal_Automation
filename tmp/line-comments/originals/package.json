{
  "name": "appraisal-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local Windows appraisal preparation with a mandatory human submission handoff",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:browser && npm run build",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.9",
    "@langchain/core": "^1.2.9",
    "@langchain/google": "^0.2.5",
    "@langchain/openai": "^1.5.11",
    "@langchain/xai": "^1.4.12",
    "@napi-rs/canvas": "^1.0.9",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "langchain": "^1.5.10",
    "multer": "^2.3.0",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
